# Cloud image for ECS Express Mode / Fargate.
# Bakes the prebuilt local index (+ embedding cache) so the container can serve
# Q&A without volume mounts. Secrets still come from runtime env / Secrets Manager.
#
# Build (from repo root, AFTER local index exists):
#   docker build -f Dockerfile.cloud -t fin-rag-lab:cloud .
#
# Never bake .env / API keys into this image.

FROM python:3.11-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY app/ app/
COPY scripts/ scripts/
COPY data/golden_set/ data/golden_set/
COPY data/uploads/ data/uploads/
COPY .env.example .env.example

# Prebuilt RAG artifacts for the first cloud MVP (no EFS/S3 yet)
COPY index/ index/
COPY cache/embeddings/ cache/embeddings/

RUN mkdir -p cache/docs cache/vlm \
    && useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app

USER appuser

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_ENABLE_CORS=false

EXPOSE 8501

# ALB / ECS health checks should use this path (returns plain "ok")
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "app/streamlit_app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--browser.gatherUsageStats=false"]
