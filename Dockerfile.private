# Private API; corpus lives in Postgres/private objects, never in this image.
FROM python:3.11-slim-bookworm
WORKDIR /app
COPY requirements-private.txt .
RUN pip install --no-cache-dir -r requirements-private.txt
COPY src/ src/
COPY scripts/sources.py scripts/sources.py
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p cache index && chown -R appuser:appuser /app
USER appuser
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LANGSMITH_TRACING=false
EXPOSE 8000
# Uvicorn rejects at >= limit; 3 admits the intended two concurrent requests.
CMD ["uvicorn", "src.api.private_server:build_private_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--limit-concurrency", "3", "--no-access-log"]
