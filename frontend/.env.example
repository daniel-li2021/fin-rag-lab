# All capabilities default to demo. These are server-only settings, never NEXT_PUBLIC_*.
FINRAG_RESEARCH_MODE=demo
FINRAG_LIBRARY_MODE=demo
FINRAG_HISTORY_MODE=demo
FINRAG_COLLECTIONS_MODE=demo
FINRAG_EVIDENCE_MODE=demo
# Future private live access only. Set actual values in the hosting secret manager.
